# Required for GPT-Live voice conversations.
OPENAI_API_KEY=
GATEWAY_TOKENS=change-me-token:demo-user
PORT=8788

# GPT-Live uses this Responses model for reasoning and optional web search.
LIVE_BACKEND_MODEL=gpt-5.6-luna
STORE_PATH=./data/gateway-store.json

# Optional: only needed for the legacy Claude agent / connected-app routes.
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
QUICK_ANSWER_TIMEOUT_MS=30000
STATE_SECRET=
PUBLIC_BASE_URL=https://your-gateway.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: delegate this one authenticated Watch user's requests to OpenClaw.
# BASE_URL includes /v1. Leave all three unset to disable the connector.
OPENCLAW_BASE_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_USER_ID=
OPENCLAW_AGENT_ID=main
# Required together when Cloudflare Access protects the OpenClaw API.
OPENCLAW_CF_ACCESS_CLIENT_ID=
OPENCLAW_CF_ACCESS_CLIENT_SECRET=

# Durable background research: MUST be on a persistent disk in production.
RESEARCH_STORE_PATH=
# APNs server-only signing key; never bundle this key in the app.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_IOS_TOPIC=maxonary.chime
APNS_WATCH_TOPIC=maxonary.chime.watchkitapp

# Experimental ChatGPT dot TEXT bridge. Disabled until separately authorized setup.
# See ../docs/chatgpt-dot-bridge.md; does not enable Watch audio routing.
DOT_BRIDGE_ENABLED=false
# DOT_AUTH_MODE=oauth
# DOT_USER_ID=<existing gateway owner>
# DOT_STORE_PATH=/data/chime-dot.json
# DOT_CALLBACK_HOSTS=<verified exact callback hostname>
# DOT_OAUTH_ISSUER=https://<trusted existing issuer>
# DOT_OAUTH_JWKS_URL=https://<trusted existing issuer>/<jwks path>
# DOT_OAUTH_RESOURCE=https://<gateway hostname>/mcp/dot
# DOT_OAUTH_SUBJECT=<authorized immutable subject>
